# Terraform working dirs & state (state contains object IDs and may contain secrets)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Variable files may hold credentials
*.tfvars
*.tfvars.json

# Local env / secrets
.env
.env.*
*.pem
*.key

# Generated by the module when write_*_file is enabled
defaults_effective.yaml
objects_written.yaml

# Python
.venv/
__pycache__/
